{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/redblaqberry/discoveryspec/schemas/deployment-contract.v1.schema.json",
  "title": "deployment-contract.v1",
  "description": "Executable deployment contract compiled from a technical discovery transcript. Every executable entry references a requirement, and every requirement traces to numbered transcript turns or an explicitly recorded follow-up. Actions not listed in allowed_actions are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "metadata",
    "requirements",
    "open_questions",
    "kpis",
    "roles",
    "allowed_actions",
    "escalation_rules",
    "security_constraints",
    "slo",
    "environment",
    "data_governance"
  ],
  "properties": {
    "contract_version": { "const": "deployment-contract.v1" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "customer", "transcript", "transcript_sha256", "status", "approved_by", "approved_at"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "customer": { "type": "string", "minLength": 1 },
        "transcript": { "type": "string", "minLength": 1 },
        "transcript_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the exact transcript bytes provenance was extracted from; validation fails if a different transcript is supplied."
        },
        "status": { "enum": ["draft", "approved"] },
        "approved_by": { "type": ["string", "null"] },
        "approved_at": {
          "type": ["string", "null"],
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "statement", "category", "stakeholder", "source_turns", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "category": {
            "enum": ["kpi", "role", "allowed_action", "escalation", "security", "latency", "cost", "data", "environment"]
          },
          "stakeholder": { "type": "string", "minLength": 1 },
          "source_turns": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 },
            "description": "Transcript turn numbers this requirement was extracted from. May be empty only when followup_note is set."
          },
          "followup_note": {
            "type": ["string", "null"],
            "description": "Provenance for requirements established outside the transcript, e.g. a recorded post-call answer. Required when source_turns is empty."
          },
          "status": { "enum": ["resolved", "conflict"] },
          "conflicts_with": {
            "type": "array",
            "items": { "type": "string", "pattern": "^REQ-[0-9]{3}$" },
            "default": []
          },
          "resolution": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["decision", "rationale", "resolved_by", "date"],
            "properties": {
              "decision": { "enum": ["adopted", "rejected", "merged"] },
              "rationale": { "type": "string", "minLength": 1 },
              "resolved_by": { "type": "string", "minLength": 1 },
              "date": {
                "type": "string",
                "format": "date",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            }
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "field", "owner", "blocking", "source_turns", "status", "resolution"],
        "properties": {
          "id": { "type": "string", "pattern": "^UNK-[0-9]{3}$" },
          "question": { "type": "string", "minLength": 1 },
          "field": {
            "type": "string",
            "minLength": 1,
            "description": "Contract field this question blocks, e.g. data_governance."
          },
          "owner": { "type": "string", "minLength": 1 },
          "blocking": { "type": "boolean" },
          "source_turns": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 },
            "minItems": 1
          },
          "status": { "enum": ["open", "resolved"] },
          "resolution": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["answer", "resolved_by", "date", "resulting_requirements"],
            "properties": {
              "answer": { "type": "string", "minLength": 1 },
              "resolved_by": { "type": "string", "minLength": 1 },
              "date": {
                "type": "string",
                "format": "date",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "resulting_requirements": {
                "type": "array",
                "items": { "type": "string", "pattern": "^REQ-[0-9]{3}$" }
              }
            }
          }
        }
      }
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "target", "unit", "direction", "requirement_id"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "target": { "type": "number" },
          "unit": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["at_least", "at_most"] },
          "requirement_id": { "type": "string", "pattern": "^REQ-[0-9]{3}$" }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "permissions", "requirement_id"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": { "type": "string", "minLength": 1 },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "description": "Human-side capabilities of this role inside the customer workflow. A separate namespace from allowed_actions (which lists agent actions); a shared word does not imply the other list."
          },
          "requirement_id": { "type": "string", "pattern": "^REQ-[0-9]{3}$" }
        }
      }
    },
    "allowed_actions": {
      "type": "array",
      "description": "Exhaustive allowlist of AGENT actions; any agent action not listed here is forbidden. Human role capabilities live in roles[].permissions, a separate namespace.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "allowed_roles", "requires_human_approval", "requirement_id"],
        "properties": {
          "action": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "allowed_roles": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          },
          "requires_human_approval": { "type": "boolean" },
          "requirement_id": { "type": "string", "pattern": "^REQ-[0-9]{3}$" }
        }
      }
    },
    "escalation_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trigger", "action", "requirement_id"],
        "properties": {
          "trigger": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "requirement_id": { "type": "string", "pattern": "^REQ-[0-9]{3}$" }
        }
      }
    },
    "security_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constraint", "requirement_id"],
        "properties": {
          "constraint": { "type": "string", "minLength": 1 },
          "requirement_id": { "type": "string", "pattern": "^REQ-[0-9]{3}$" }
        }
      }
    },
    "slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p95_latency_ms", "cost_per_invoice_eur"],
      "properties": {
        "p95_latency_ms": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["value", "requirement_id"],
          "properties": {
            "value": { "type": "integer", "minimum": 1 },
            "requirement_id": { "type": "string", "pattern": "^REQ-[0-9]{3}$" }
          }
        },
        "cost_per_invoice_eur": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["value", "requirement_id"],
          "properties": {
            "value": { "type": "number", "exclusiveMinimum": 0 },
            "requirement_id": { "type": "string", "pattern": "^REQ-[0-9]{3}$" }
          }
        }
      }
    },
    "environment": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "seed", "requirement_id"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer" },
        "requirement_id": { "type": "string", "pattern": "^REQ-[0-9]{3}$" }
      }
    },
    "data_governance": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["owner", "retention_days", "region", "requirement_id"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "retention_days": { "type": "integer", "minimum": 1 },
        "region": { "type": "string", "minLength": 1 },
        "requirement_id": { "type": "string", "pattern": "^REQ-[0-9]{3}$" }
      }
    }
  }
}
